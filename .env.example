# Copy to .env.local and adjust. Never commit real secrets.

# URL of the analysis backend (public, not a secret).
# Local backend:   http://localhost:8000
# Deployed (Modal): https://<your-workspace>--tajweed-coach-ai-api-web.modal.run
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Optional: Quran Foundation API credentials (server-side only).
# Leave empty to use the public Quran.com API instead.
# QURAN_CLIENT_ID=
# QURAN_CLIENT_SECRET=
